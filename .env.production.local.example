# 실 배포 오버라이드 예시 (ADR 0011 — 기본 빌드가 실 백엔드 전제).
# 사용법: cp .env.production.local.example .env.production.local 후 실제 값으로 채우세요.
#
# .env.production.local 은 .gitignore(.env.*.local)로 추적되지 않습니다(시크릿 사고 방지).
# Vite 모드 우선순위상 .env.production.local 이 .env.production(실 백엔드 기본값)보다 우선 적용됩니다.
# VITE_ 접두 변수는 빌드타임에 번들로 정적 치환되며 클라이언트에 노출됩니다 — 시크릿 금지.
# 전환 배경: docs/adr/0011-backend-first-workflow.md, docs/adr/0008-demo-to-real-backend-switch.md

VITE_API_BASE_URL=https://api.example.com   # ← 실제 백엔드 origin 으로 교체
VITE_ENABLE_MOCK=false                       # 실 백엔드 연동 시 MSW 목 비활성화
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
