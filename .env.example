# 이 파일은 개발(.env)용 예시입니다 — cp .env.example .env.
# 프로덕션 실 백엔드 오버라이드는 .env.production.local.example 와 docs/adr/0011-backend-first-workflow.md 참고.

# API base URL — 실제 백엔드 주소로 교체하세요.
VITE_API_BASE_URL=http://localhost:3000

# MSW 목 API 활성화 여부. 기본은 false(실 백엔드 전제). 백엔드 없이 데모로 띄우려면 `--mode demo`(.env.demo).
VITE_ENABLE_MOCK=false

# Sentry DSN — 설정 시에만 에러 트래킹이 활성화됩니다(미설정 시 no-op).
# 모든 VITE_ 접두 변수는 클라이언트 번들에 그대로 노출됩니다(시크릿 금지). DSN 은 공개값이라 안전.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
