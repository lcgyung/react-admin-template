# API base URL — 실제 백엔드 주소로 교체하세요.
VITE_API_BASE_URL=http://localhost:3000

# MSW 목 API 활성화 여부. 실제 백엔드를 연동하면 false 로 변경하세요.
VITE_ENABLE_MOCK=true

# Sentry DSN — 설정 시에만 에러 트래킹이 활성화됩니다(미설정 시 no-op).
# 모든 VITE_ 접두 변수는 클라이언트 번들에 그대로 노출됩니다(시크릿 금지). DSN 은 공개값이라 안전.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
